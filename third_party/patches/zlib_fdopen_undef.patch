+/* On some platforms/configurations zutil.h defines fdopen as a macro
+ * (e.g. fdopen(fd,mode) -> NULL). This breaks system headers that declare
+ * fdopen() as a function (macOS SDK does), causing compilation errors.
+ * Ensure stdio.h sees the real identifier.
+ */
+#ifdef fdopen
+#undef fdopen
+#endif
+
